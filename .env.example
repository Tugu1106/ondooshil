# Office Radio — environment (spec §13)
#
# Copy to .env.local and fill in. None of these may ever be prefixed NEXT_PUBLIC_:
# every one is a server-side secret, and the service role key bypasses all database
# permissions.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud console → YouTube Data API v3 key. Not needed until Phase 2.
YOUTUBE_API_KEY=

# Signing key for iron-session cookies. Must be 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# IANA time zone name for day boundaries — the queue resets at 00:00 here.
# (Named TZ_OFFSET by the spec; it holds a zone name, not a numeric offset.)
TZ_OFFSET=Asia/Ulaanbaatar
